generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             Int           @id @default(autoincrement())
  publicId       String        @unique
  firstName      String
  lastName       String
  email          String        @unique
  password       String
  jobRole        String        @default("Developer")
  position       String        @default("USER")
  phone          String?
  dateOfBirth    String
  dateRegistered DateTime      @default(now())
  projects       Project[]     @relation("ProjectMembers")
  assignedGames  Project[]     @relation("UserGames")
  uploadedFiles  ProjectFile[]
  commits        Commit[]
  comments       Comment[]
  resources      Resource[]
  chatRooms      ChatRoom[]    @relation("ChatRoomMembers")
  messages       Message[]
  friendsAdded   Friendship[]  @relation("FriendshipUser")
  friendsReceived Friendship[] @relation("FriendshipFriend")
}

model Project {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  users         User[]        @relation("ProjectMembers")
  assignedUsers User[]        @relation("UserGames")
  files         ProjectFile[]
  assets        Asset[]
  commits       Commit[]
}

model ProjectFile {
  id           Int      @id @default(autoincrement())
  name         String
  type         String
  content      String?
  url          String?
  folder       String   @default("/")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  projectId    Int
  project      Project  @relation(fields: [projectId], references: [id])
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  commits      Commit[]
}

model Commit {
  id          Int         @id @default(autoincrement())
  message     String
  fileType    String
  fileName    String
  content     String?
  url         String?
  createdAt   DateTime    @default(now())
  projectId   Int
  project     Project     @relation(fields: [projectId], references: [id])
  fileId      Int
  file        ProjectFile @relation(fields: [fileId], references: [id])
  authorId    Int
  author      User        @relation(fields: [authorId], references: [id])
  comments    Comment[]
}

model Comment {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  commitId  Int
  commit    Commit    @relation(fields: [commitId], references: [id])
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id])
  parentId  Int?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
}

model ResourceCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  resources   Resource[]
}

model Resource {
  id           Int              @id @default(autoincrement())
  name         String
  description  String?
  type         String
  fileType     String?
  url          String
  folder       String?
  createdAt    DateTime         @default(now())
  categoryId   Int
  category     ResourceCategory @relation(fields: [categoryId], references: [id])
  createdById  Int
  createdBy    User             @relation(fields: [createdById], references: [id])
}

model ChatRoom {
  id        Int       @id @default(autoincrement())
  name      String?
  type      String    @default("GROUP") // DM or GROUP
  createdAt DateTime  @default(now())
  members   User[]    @relation("ChatRoomMembers")
  messages  Message[]
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  createdAt  DateTime @default(now())
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  chatRoomId Int
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])
}

model Friendship {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING") // PENDING or ACCEPTED
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation("FriendshipUser", fields: [userId], references: [id])
  friendId  Int
  friend    User     @relation("FriendshipFriend", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model Asset {
  id         Int      @id @default(autoincrement())
  name       String
  type       String
  url        String
  uploadedAt DateTime @default(now())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id])
}